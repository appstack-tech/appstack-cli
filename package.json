{
  "name": "@appstack-tech/cli",
  "version": "0.1.0",
  "description": "Agent-powered Appstack SDK integration, review, and upgrades.",
  "type": "module",
  "bin": {
    "appstack": "dist/bin.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx bin.ts",
    "test": "tsx --test $(rg --files tests -g '*.test.ts')",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/yargs": "^17.0.33",
    "tsdown": "^0.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
